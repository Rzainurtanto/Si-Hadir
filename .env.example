# ===================================================
# KONFIGURASI ENVIRONMENT SI-HADIR
# ===================================================

# Port server & dashboard (default: 3000)
PORT=3000

# Path file database SQLite (di docker otomatis /app/data/sihadir.db)
DB_PATH=data/sihadir.db

# Kunci rahasia untuk ESP8266 (opsional, jika diisi ESP8266 wajib mengirim header X-Device-Key)
DEVICE_KEY=

# Akun admin default saat database pertama kali diinisialisasi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Ubah ke true jika aplikasi berjalan di balik HTTPS/SSL (Nginx reverse proxy / Cloudflare)
COOKIE_SECURE=false

# Ubah ke true jika ingin otomatis mengisi 20 mahasiswa & 2 matkul contoh saat pertama kali jalan
AUTO_SEED=false
